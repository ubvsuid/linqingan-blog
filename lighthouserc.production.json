{
  "ci": {
    "collect": {
      "url": [
        "https://www.linqingan.com/",
        "https://www.linqingan.com/blog",
        "https://www.linqingan.com/knowledge",
        "https://www.linqingan.com/search?q=creep",
        "https://www.linqingan.com/blog/screeps-memory-basics",
        "https://www.linqingan.com/tools/room-diagnostics",
        "https://www.linqingan.com/en",
        "https://www.linqingan.com/en/blog",
        "https://www.linqingan.com/en/search?q=creep%20not%20moving",
        "https://www.linqingan.com/en/tools/room-diagnostics"
      ],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 400 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }]
          }
        },
        {
          "matchingUrlPattern": "^https://www\\.linqingan\\.com/(?!search(?:\\?|$)|en/search(?:\\?|$)).*",
          "assertions": {
            "categories:seo": ["error", { "minScore": 0.95 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-production-results"
    }
  }
}
