NEXT_PUBLIC_SITE_URL=https://www.linqingan.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Database environment isolation
# - Local development and Vercel Preview/Development MUST use Neon branch: gpt-work-dev.
# - Vercel Production MUST use Neon branch: main.
# - Never copy the production DATABASE_URL into local or Preview environments.
DATABASE_URL=

# Operational Node scripts default to non-production. Production database operations
# must opt in explicitly with DATABASE_RUNTIME=production, and the endpoint must still
# match the production Neon endpoint. Do not set this globally for local development.
# DATABASE_RUNTIME=non-production
